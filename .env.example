# Database (defaults to local SQLite if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/recoverai

# Razorpay integration mode: "mock" (default, no credentials needed) or "live_test"
RECOVERAI_RAZORPAY_MODE=mock

# Only needed if RECOVERAI_RAZORPAY_MODE=live_test
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# AI diagnosis mode: "auto" (default: use LLM if ANTHROPIC_API_KEY is set, else
# rule-based), "llm" (force LLM, errors if no key), or "rule_based" (force
# the deterministic scorer, e.g. for fast/offline batch runs)
RECOVERAI_DIAGNOSIS_MODE=auto
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Optional override; defaults to a small/fast model since diagnosis runs once per transaction
# RECOVERAI_DIAGNOSIS_MODEL=claude-haiku-4-5-20251001
